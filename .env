# --- Telegram ---
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# --- Firebase Admin SDK ---
# Option A (recommended for hosts that only support env vars, e.g. Suga,
# Railway, Fly.io, Render): base64-encode your serviceAccountKey.json and
# paste the result here.
#   macOS/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B: paste the raw JSON key content directly (some dashboards don't
# like long base64 strings; either A or B works, you only need one).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Option C (local machine / VPS only): path to the JSON file on disk.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# --- HTTP server (optional, defaults to 3000) ---
PORT=3000

# --- SMTP (required only for emailing replies to Contact Messages) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# Use a Google App Password, not your normal Gmail password
SMTP_PASS=your_app_password_here
MAIL_FROM=your_email@gmail.com
